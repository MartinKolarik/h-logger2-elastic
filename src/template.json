{
	"settings": {
		"index": {
			"number_of_shards": "1",
			"number_of_replicas": "0"
		}
	},
	"mappings": {
		"dynamic": "false",
		"date_detection": false,
		"properties": {
			"@timestamp": {
				"type": "date"
			},
			"scope": {
				"type": "keyword"
			},
			"message": {
				"type": "match_only_text"
			},
			"host.hostname": {
				"type": "keyword"
			},
			"host.name": {
				"type": "keyword"
			},
			"log.level": {
				"type": "keyword"
			},
			"process.pid": {
				"type": "long"
			},
			"service.name": {
				"type": "keyword"
			},
			"service.environment": {
				"type": "keyword"
			},
			"trace.id": {
				"type": "keyword"
			},
			"transaction.id": {
				"type": "keyword"
			},
			"span.id": {
				"type": "keyword"
			},
			"context": {
				"type": "object",
				"dynamic": true
			},
			"error.name": {
				"type": "keyword"
			},
			"error.code": {
				"type": "keyword"
			},
			"error.message": {
				"type": "match_only_text"
			}
		},
		"dynamic_templates": [
			{
				"string_only_context": {
					"path_match": [
						"context.*"
					],
					"mapping": {
						"type": "keyword"
					},
					"unmatch_mapping_type": "object"
				}
			},
			{
				"flatten": {
					"path_match": [
						"context.flatten.*"
					],
					"mapping": {
						"type": "flattened"
					},
					"match_mapping_type": "object"
				}
			},
			{
				"auto_flatten": {
					"path_match": [
						"context.*.*.*"
					],
					"mapping": {
						"type": "flattened"
					},
					"match_mapping_type": "object"
				}
			}
		]
	}
}
